POSTGRES_DB=faperon
POSTGRES_USER=faperon
POSTGRES_PASSWORD=troque-esta-senha
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
# Hosts aceitos pelo Django. "api" é obrigatório (o Next chama http://api:8000); não use "*".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Origem pública do Funnel (ex.: https://notebook.tailnet-xyz.ts.net) para CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=
# URL pública do site (na vinicin: https://vinicin.tail3fe9ce.ts.net:8443). Usada no BUILD do web; mudou, rode docker compose up -d --build web.
SITE_URL=http://localhost:3000
# Segredo do webhook do GitHub (Settings > Webhooks); sem ele o serviço webhook do compose recusa subir (ADR 0021)
GITHUB_WEBHOOK_SECRET=
# Gunicorn da API (ver docs/adr/0025): processos, threads por processo e timeout em segundos
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
# Limites do PDF (ver docs/adr/0023): por IP e somando todos os visitantes
PDF_RATE_LIMIT=10/min
PDF_GLOBAL_RATE_LIMIT=30/min
# Zétele, assistente de IA do site (ADR 0029). A ANTHROPIC_API_KEY fica no .env.local (fora do git), nunca aqui.
ZETELE_RATE_LIMIT=6/min
ZETELE_GLOBAL_RATE_LIMIT=30/min
# Zétele do site público (ADR 0032)
ZETELE_LIMITE_DIARIO=200
# Zétele da área do sistema: limite próprio, que inclui o agendamento por voz
ZETELE_SISTEMA_LIMITE_DIARIO=250
ZETELE_SISTEMA_RATE_LIMIT=10/min
ZETELE_SISTEMA_GLOBAL_RATE_LIMIT=30/min
ZETELE_SIMULTANEOS=3
# Voz do Zétele do sistema (ADR 0034): ouvir pela Groq, falar pelo Gemini. GROQ_API_KEY e GEMINI_API_KEY
# ficam no .env.local, nunca aqui; sem a chave de um fornecedor, aquela metade da voz fica desligada.
ZETELE_OUVIR_PROVEDOR=groq
ZETELE_FALAR_PROVEDOR=gemini
ZETELE_OUVIR_MODELO=whisper-large-v3-turbo
ZETELE_FALAR_MODELO=gemini-3.8-flash-lite-tts
ZETELE_FALAR_VOZ=Kore
# ouvir e falar dividem estes limites; o falar conta no ZETELE_SISTEMA_LIMITE_DIARIO
ZETELE_VOZ_RATE_LIMIT=10/min
ZETELE_VOZ_GLOBAL_RATE_LIMIT=30/min
