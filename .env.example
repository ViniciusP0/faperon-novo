POSTGRES_DB=faperon
POSTGRES_USER=faperon
POSTGRES_PASSWORD=troque-esta-senha
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
# Hosts aceitos pelo Django. "api" é obrigatório (o Next chama http://api:8000); não use "*".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Origem pública do Funnel (ex.: https://notebook.tailnet-xyz.ts.net) para CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=
# URL pública do site (no dt-server: https://dt-server.tail3fe9ce.ts.net). Usada no BUILD do web; mudou, rode docker compose up -d --build web.
SITE_URL=http://localhost:3000
# Segredo do webhook do GitHub (Settings > Webhooks) para deploy automático, ver infra/webhook_listener.py
GITHUB_WEBHOOK_SECRET=
# Gunicorn da API (ver docs/adr/0025): processos, threads por processo e timeout em segundos
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
# Limites do PDF (ver docs/adr/0023): por IP e somando todos os visitantes
PDF_RATE_LIMIT=10/min
PDF_GLOBAL_RATE_LIMIT=30/min
